# Server Environment Variables
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/bro_code

# Authentication
JWT_SECRET=your_jwt_secret_key_min_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Initial Admin Bootstrap (Optional for seedAdmin script)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@brocode.hostel
ADMIN_PASSWORD=change_this_password_123

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

